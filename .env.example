# Cloudflare Pages — production payment bindings
# Set in Pages → Settings → Environment variables / KV bindings
# Never commit real secrets. Local: .dev.vars (gitignored)

ENVIRONMENT=production

# Required (production)
STRIPE_SECRET_KEY=rk_live_or_sk_live_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
SITE_ORIGIN=https://embersoullabs.com

# Required KV binding name: PAYMENT_EVENTS
# (bind a KV namespace in Pages/Workers settings — not a plain env string)

# Customer portal. Login codes are not sent until both values exist.
# RESEND_API_KEY=
# PORTAL_EMAIL_FROM=EmberSoul Labs <support@embersoullabs.com>
# EmberCore receiver. Leave empty to keep events SYNC_PENDING.
# EMBERCORE_WEBHOOK_URL=
# EMBERCORE_OUTBOUND_SECRET=
# EMBERCORE_INBOUND_SECRET=
# Private file binding plus a scanner. Uploads stay disabled without both.
# ASSET_BUCKET=
# ASSET_SCANNER=

# Local/dev ONLY (never set in production):
# ENVIRONMENT=development
# ALLOW_IN_MEMORY_IDEMPOTENCY=true
# ALLOW_DEV_HOST_ORIGIN=true
# SITE_ORIGIN=http://127.0.0.1:8788
